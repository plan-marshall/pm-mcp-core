{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuioss.de/plan-marshall-mcp/schemas/judge-check-record.json",
  "title": "JudgeCheckRecord",
  "type": "object",
  "required": ["format_version", "qualification_digest", "harness", "model", "corpus_revision", "oracle_accuracy", "blind_accuracy", "constant_baseline", "unscored", "checked_at", "items"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "qualification_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The qualification digest of the judge configuration checked; the record is valid only for a judge with the same digest." },
    "harness": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "model": { "type": "string", "minLength": 1 },
    "corpus_revision": { "type": "string", "minLength": 1 },
    "oracle_accuracy": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent of the scored answers judged as their label says, with the reference given." },
    "blind_accuracy": { "type": "number", "minimum": 0, "maximum": 100, "description": "The same with the reference withheld." },
    "constant_baseline": { "type": "number", "minimum": 0, "maximum": 100, "description": "The larger of the shares of right and wrong answers in the topic judge/." },
    "unscored": { "type": "integer", "minimum": 0, "description": "Answers whose judge task closed lost; a record with unscored > 0 has no verdict." },
    "checked_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "label", "oracle_score", "blind_score", "total_tokens", "duration_ms"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "enum": ["right", "wrong"] },
          "oracle_score": { "oneOf": [ { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "string", "const": "unscored" } ] },
          "blind_score": { "oneOf": [ { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "string", "const": "unscored" } ] },
          "total_tokens": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "string", "const": "unmeasured" } ] },
          "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
