{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuioss.de/plan-marshall-mcp/schemas/config-build-map.json",
  "title": "BuildMapConfigFile",
  "description": "Team file .marshall/config/build-map.json: the seeded, then curated file-to-build route table; read fail-closed (build_map_invalid, build_map_unseeded).",
  "type": "object",
  "required": ["format_version", "routes"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "routes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,31}$" },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["glob", "role", "build_class"],
          "additionalProperties": false,
          "properties": {
            "glob": { "type": "string", "minLength": 1, "maxLength": 256, "description": "fnmatch dialect; never **." },
            "role": { "type": "string", "enum": ["production", "test", "config"] },
            "build_class": { "type": "string", "enum": ["compile", "module-tests", "verify", "none"] }
          }
        }
      }
    }
  }
}
