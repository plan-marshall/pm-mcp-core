{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuioss.de/plan-marshall-mcp/schemas/task-record.json",
  "title": "TaskRecord",
  "type": "object",
  "required": [
    "format_version",
    "task_id",
    "deliverable_id",
    "title",
    "profile",
    "status",
    "skills",
    "target_files",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "deliverable_id": { "type": "string", "pattern": "^D[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "enum": ["implementation", "module_testing", "integration_testing", "documentation", "verification"] },
    "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "infeasible", "removed"] },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
      "uniqueItems": true,
      "default": [],
      "description": "Tasks that must be completed before this task is packed into an envelope. Checked by the server at creation: every reference exists and the graph is acyclic."
    },
    "disposition": {
      "type": ["object", "null"],
      "description": "Required when status is infeasible or removed; null otherwise.",
      "required": ["by", "reason", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "enum": ["worker", "outline_gate", "model", "operator"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["string", "null"], "description": "infeasible only: the worker's evidence submitted with infeasible:TASK-NNN." },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "cost_size": { "type": "string", "enum": ["XS", "S", "M", "L", "XL", "XXL"], "description": "Derived by TaskCostEstimator from steps, profile, skills and target_files (model-work.adoc, Envelope Tasks, Cost Sizing)." },
    "predicted_cost_tokens": { "type": "integer", "minimum": 0, "description": "The size-to-token table value of cost_size at planning time; never a per-task computation." },
    "predicted_cost_basis": { "type": "string", "enum": ["uncalibrated", "calibrated"], "description": "Basis of the size-to-token table that produced predicted_cost_tokens." },
    "envelope_id": { "type": ["string", "null"], "pattern": "^envelope-[0-9]+$" },
    "skills": { "type": "array", "items": { "type": "string" } },
    "target_files": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["commands", "criteria"],
      "additionalProperties": false,
      "properties": {
        "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Stored verbatim, multi-line text preserved." },
        "manual": { "type": "boolean", "default": false }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_number", "description", "status"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "completed", "skipped", "failed"] }
        }
      }
    }
  }
}
