{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuioss.de/plan-marshall-mcp/schemas/metrics.json",
  "title": "MetricsStore",
  "type": "object",
  "required": ["format_version", "rows"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/taskRow" },
          { "$ref": "#/$defs/workerIdleRow" },
          { "$ref": "#/$defs/waitRow" },
          { "$ref": "#/$defs/phaseCloseRow" },
          { "$ref": "#/$defs/servedReadRow" }
        ]
      }
    }
  },
  "$defs": {
    "measure": {
      "description": "A measured integer or 'unmeasured'.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "const": "unmeasured" }
      ]
    },
    "component": {
      "description": "A token component: a measured integer, 'unmeasured', or 'not_applicable' where the harness's profile declares the figure absent by design (counted 0).",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "enum": ["unmeasured", "not_applicable"] }
      ]
    },
    "harness": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$", "description": "harness_id of an enrolled harness (identifiers.adoc, harness_id), an operator-added harness included." },
    "phase": { "type": "string", "enum": ["phase-1-init", "phase-2-refine", "phase-3-outline", "phase-4-plan", "phase-5-execute", "phase-6-finalize"] },
    "taskRow": {
      "type": "object",
      "required": ["kind", "queue_task_id", "attempt", "role", "job_id", "generation_id", "harness", "harness_version", "model", "effort", "form", "phase", "step_id", "envelope_id", "predicted_cost", "outcome", "continuation", "cause_class", "spend_class", "population", "total_tokens", "input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "reasoning_tokens", "tool_uses", "cost_usd", "unmeasured_reason", "duration_ms", "duration_basis", "queued_ms", "consultation_of", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "task" },
        "queue_task_id": { "type": "string", "pattern": "^qt-[0-9a-f]{16}$" },
        "attempt": { "type": ["integer", "null"], "minimum": 1, "description": "The attempt of the queue task this row measures (Queue Task Record, attempts[]); null only for a task closed without an attempt (cause_class refused)." },
        "continuation": { "type": ["string", "null"], "enum": ["hold", "resume", null], "description": "That the row is the usage of a continuation, and which form carried it (model-work/06, Accounting): hold for the wake-ups of a holding generation, resume for a generation started from the stored session; null for a task that never continued. The fallback rows of the same task carry null, so the two populations compare per role and harness." },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$", "description": "Role of the task (identifiers.adoc, role name)." },
        "job_id": { "type": ["string", "null"], "pattern": "^l-[0-9a-f]{16}$", "description": "The worker that served the attempt; null only for a task closed without an attempt (cause_class refused)." },
        "generation_id": { "type": ["string", "null"], "pattern": "^l-[0-9a-f]{16}$", "description": "null only for a task closed without an attempt (cause_class refused)." },
        "harness": { "anyOf": [ { "$ref": "#/$defs/harness" }, { "type": "null" } ], "description": "The worker's harness; null only for a task closed without an attempt (cause_class refused)." },
        "harness_version": { "type": ["string", "null"], "maxLength": 64, "description": "The version of the harness as probed at its worker's spawn (store-schemas/11, Harness Enrolment Store); null only for a task closed without an attempt (cause_class refused)." },
        "model": { "type": ["string", "null"], "description": "Model passed to the harness, the role's effective value; null only for a task closed without an attempt (cause_class refused)." },
        "effort": { "type": ["string", "null"], "description": "Effort passed to the harness after narrowing; null when none was passed." },
        "form": { "type": ["string", "null"], "enum": ["warm", "fresh", null], "description": "The worker's form; null only for a task closed without an attempt (cause_class refused)." },
        "phase": { "anyOf": [ { "$ref": "#/$defs/phase" }, { "type": "null" } ], "description": "null for a task of the epic or workspace scope." },
        "step_id": { "type": ["string", "null"] },
        "envelope_id": { "type": ["string", "null"], "pattern": "^envelope-[0-9]+$" },
        "yield_reason": { "type": ["string", "null"], "enum": ["chain_tail", "question", "context", "off_track", null], "description": "Envelope tasks only: the early-end exit the server recorded (model-work/06, Early End of an Envelope Task; off_track: the yield the server took on an off-track signal, model-work/03, A Worker Off Track); null for any other task and for an envelope task that ended without one." },
        "predicted_cost": {
          "type": ["object", "null"],
          "required": ["tokens", "basis"],
          "additionalProperties": false,
          "properties": {
            "tokens": { "type": "integer", "minimum": 0, "description": "Summed predicted_cost_tokens of the envelope." },
            "basis": { "type": "string", "enum": ["uncalibrated", "calibrated"] }
          }
        },
        "outcome": { "type": "string", "enum": ["submitted", "asked", "infeasible", "lost"], "description": "The task's outcome, or lost for an attempt that was offered again (Queue Task Record)." },
        "cause_class": { "type": "string", "enum": ["terminal_error", "retryable", "returned_with_findings", "benign", "stall", "refused"] },
        "spend_class": { "type": "string", "enum": ["submitted", "findings_only", "no_product", "unmeasured"] },
        "population": { "type": "string", "enum": ["model_job", "model_task"], "description": "model_job: a fresh worker's whole run; model_task: a task a warm worker served." },
        "total_tokens": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "string", "const": "unmeasured" } ], "description": "Derived: the sum of the five token components, a not_applicable one counting 0, when every applicable one is measured, otherwise unmeasured; a derived sum of 0 is recorded unmeasured (lower bound 1); never parsed from the harness output." },
        "input_tokens": { "$ref": "#/$defs/measure" },
        "output_tokens": { "$ref": "#/$defs/measure" },
        "cache_read_input_tokens": { "$ref": "#/$defs/component" },
        "cache_creation_input_tokens": { "$ref": "#/$defs/component" },
        "reasoning_tokens": { "$ref": "#/$defs/component" },
        "tool_uses": { "$ref": "#/$defs/measure" },
        "cost_usd": { "oneOf": [ { "type": "number", "minimum": 0 }, { "type": "string", "const": "unmeasured" } ], "description": "Harness-reported cost, recorded data only: never shown, never summed into a figure the operator sees, never read by a rule; unmeasured where the harness reports none." },
        "unmeasured_reason": { "type": ["string", "null"], "enum": ["not_reported_by_harness", "output_unparsed", "terminated", null] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "duration_basis": { "type": ["string", "null"], "enum": ["process", "task", null], "description": "process: spawn to exit of a fresh worker's job; task: offer to the attempt's end for a warm worker; null only for a task closed without an attempt (cause_class refused)." },
        "queued_ms": { "type": ["integer", "null"], "minimum": 0, "description": "Time the task waited queued before its offer; null when it never waited." },
        "consultation_of": { "type": ["string", "null"], "pattern": "^qt-[0-9a-f]{16}$", "description": "A consultation's row: the asking task (PM-WORK-4); null otherwise." },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "workerIdleRow": {
      "type": "object",
      "required": ["kind", "job_id", "role", "harness", "harness_version", "model", "population", "total_tokens", "input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "reasoning_tokens", "tool_uses", "cost_usd", "unmeasured_reason", "idle_wakeups", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "worker_idle" },
        "job_id": { "type": "string", "pattern": "^l-[0-9a-f]{16}$", "description": "The warm worker." },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "harness": { "$ref": "#/$defs/harness", "description": "A harness whose profile allows the warm form." },
        "harness_version": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "population": { "type": "string", "const": "worker_idle" },
        "total_tokens": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "string", "const": "unmeasured" } ] },
        "input_tokens": { "$ref": "#/$defs/measure" },
        "output_tokens": { "$ref": "#/$defs/measure" },
        "cache_read_input_tokens": { "$ref": "#/$defs/component" },
        "cache_creation_input_tokens": { "$ref": "#/$defs/component" },
        "reasoning_tokens": { "$ref": "#/$defs/component" },
        "tool_uses": { "$ref": "#/$defs/measure" },
        "cost_usd": { "oneOf": [ { "type": "number", "minimum": 0 }, { "type": "string", "const": "unmeasured" } ], "description": "Recorded data only, as on a task row." },
        "unmeasured_reason": { "type": ["string", "null"], "enum": ["not_reported_by_harness", "output_unparsed", "terminated", null] },
        "idle_wakeups": { "type": "integer", "minimum": 0, "description": "Wake-ups without a task over the worker's generation." },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "waitRow": {
      "type": "object",
      "required": ["kind", "phase", "wait_reason", "deliberate", "duration_ms", "started_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "wait" },
        "phase": { "$ref": "#/$defs/phase" },
        "wait_reason": { "type": "string", "enum": ["build", "git", "ci", "model_job", "review_bot_window", "operator_wait", "paused", "merge_queue", "merge_mutex", "server_retry", "provider_rate_limit", "prerequisite", "integrity_hold"], "description": "Wait attribution reason (operator_wait: an operator wait of the plan, a decision or a waiver request among them; paused: the operator's pause; integrity_hold: the scope held by an integrity_breach, recorded deliberate false); the closed enum and the mapping of every wait to one reason are defined in job-runtime.adoc, Wait Attribution." },
        "deliberate": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string", "format": "date-time" }
      }
    },
    "phaseCloseRow": {
      "type": "object",
      "required": ["kind", "phase", "start_time", "end_time", "duration_ms", "duration_clamped", "boundary", "step_firings"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "phase_close" },
        "phase": { "$ref": "#/$defs/phase" },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "duration_clamped": { "type": "boolean" },
        "boundary": { "type": "string", "enum": ["closed", "re_entered", "provisional"] },
        "measured_until": { "type": "string", "format": "date-time", "description": "provisional only." },
        "excluded_steps": { "type": "array", "items": { "type": "string" }, "description": "provisional only." },
        "step_firings": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "servedReadRow": {
      "type": "object",
      "required": ["kind", "uri", "bytes", "plan_id", "phase", "queue_task_id", "served_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "served_read" },
        "uri": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "plan_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$", "description": "null in the metrics.json of an epic or the workspace scope." },
        "phase": { "anyOf": [ { "$ref": "#/$defs/phase" }, { "type": "null" } ] },
        "queue_task_id": { "type": ["string", "null"], "pattern": "^qt-[0-9a-f]{16}$" },
        "served_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
