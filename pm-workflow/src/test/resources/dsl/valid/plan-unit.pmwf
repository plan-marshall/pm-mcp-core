# A plan unit written for the parser tests, not taken from any default unit.
# It covers the header with derived_from, declare lines, migrate lines and the
# primitive-driven state bodies of a plan: auto, job, composite_job and call.
workflow plan version 3 format 1 derived_from 2
scope plan
declare max_rounds = 3
declare mode = strict
declare channels = [Chat, mail]
declare floor = 0
start init.begin
migrate init.old -> init.begin
migrate review.legacy -> review.check

state init.begin
    phase init
    skill pm/plan/init
    facts plan.read-facts
    auto plan.prepare
        done -> init.dispatch
            completes init:prepare as done
        skipped -> init.dispatch
            completes init:prepare as skipped
            completes init:probe-2 as waived
        failed -> plan.aborted   # the step is recorded failed on entry
            completes init:prepare as failed

state init.dispatch
    phase init
    job build.compile
        done -> init.compose
        failed -> plan.aborted

state init.compose
    phase init
    composite_job build.compose-all
        done -> review.check

state review.check
    phase review
    call git.commit_and_push(push = enabled, attempts = 2, targets = [origin, Mirror])
        done -> review.cap-check
            guard result.pushed
        done -> review.check
            guard not result.pushed
        stepped_out -> plan.aborted

state review.cap-check
    phase review
    call git.no_args
        done -> review.empty-args

state review.empty-args
    phase review
    call git.no_args()
        done -> completed

state completed terminal merged success
    phase finalize

state plan.aborted terminal aborted failure
    phase aborted
