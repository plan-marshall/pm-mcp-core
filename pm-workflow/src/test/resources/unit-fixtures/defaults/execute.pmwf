---
name: plan
description: A unit written for the invariant and unit-loader tests.
type: workflow
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# The execute phase (Phase 5) of the plan unit, written for the invariant and unit-loader tests, never copied from
# the product. The worktree initialization precedes every task, job and commit; one envelope task state reacts only
# through execute.evaluate-envelope-return; commits go through git.commit_and_push; the deliverable build and the
# verify sweep precede the exit barrier, the only way into Phase 6 besides the fallback. The phase is shared by both
# lanes, so its loop-back to the outline (the fix_requested exit of the remediation, its action loop_back) re-enters
# outline.deep, the authoring entry every lane keeps, never a state of the light route.
workflow plan version 1 format 1
scope plan
start execute.worktree-init

state execute.worktree-init
    phase execute
    auto test.proceed
        done -> execute.envelope

state execute.envelope
    phase execute
    job llm change role implementer
        approved -> execute.evaluate-envelope-return
        lost -> execute.evaluate-envelope-return

state execute.evaluate-envelope-return
    phase execute
    auto test.next-task
        next_task -> execute.envelope
        deliverable_done -> execute.commit

state execute.commit
    phase execute
    call git.commit_and_push(push_mode = no_push)
        done -> execute.deliverable-build
        stepped_out -> finalize.hand-back

state execute.deliverable-build
    phase execute
    job test.build
        succeeded -> execute.verify-sweep
        failed -> finalize.hand-back
        cancelled -> finalize.hand-back

state execute.verify-sweep
    phase execute
    job test.build
        succeeded -> execute.exit-barrier
        failed -> execute.remediate
        cancelled -> finalize.hand-back

state execute.remediate
    phase execute
    call remediation.qgate-findings(retry_budget = 3, fix_budget = 3, waiver_wait_seconds = 3600, actions = [retry, fix, loop_back])
        resolved -> execute.verify-sweep
        waived -> execute.exit-barrier
        exhausted -> execute.replan
        fix_requested -> outline.deep
        stepped_out -> finalize.hand-back

state execute.replan
    phase execute
    call replan()
        replanned -> execute.envelope
        declined -> finalize.hand-back
        stepped_out -> finalize.hand-back

state execute.exit-barrier
    phase execute
    auto test.proceed
        done -> finalize.push-barrier
