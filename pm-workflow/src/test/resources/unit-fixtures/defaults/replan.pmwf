# The re-planning unit, written for the invariant and unit-loader tests, never copied from the product.
# It declares the shipped values of its compiled schema and asks no question.
workflow replan version 1 format 1
scope subworkflow
declare replan_budget = 3
declare base_overlap_min_files = 5
declare conflict_min_files = 10
declare prerequisite_wait_seconds = 604800
start replan.assess

state replan.assess
    phase inherit
    job llm change role planner
        approved -> replan.apply
        lost -> replan.declined

state replan.apply
    phase inherit
    auto test.proceed
        done -> replan.replanned

state replan.replanned terminal replanned success
    phase inherit

state replan.declined terminal declined failure
    phase inherit
