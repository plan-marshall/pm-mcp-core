---
name: plan
description: A unit written for the invariant and unit-loader tests.
type: workflow
icon: phase.outline
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# The outline phase of the plan unit, written for the invariant and unit-loader tests, never copied from the product.
# The deep lane passes outline.qgate before outline.gate; the light lane passes outline.light-regate, whose deep
# outcome is the light -> deep ratchet; only outline.gate enters Phase 4. Each lane routes its rework to its own
# authoring entry, no router reads the lane: the deep Q-Gate remediation re-enters outline.deep, a failed check of the
# light outline re-enters outline.light-regate, so the deep route reaches no state of the light route. Every rework
# cycle passes a job, its awaited event.
workflow plan version 1 format 1
scope plan
start outline.deep

state outline.deep
    phase outline
    job llm change role outline
        approved -> outline.qgate
        lost -> plan.return

state outline.qgate
    phase outline
    auto test.qgate
        pass -> outline.gate
        blocking -> outline.remediate

state outline.remediate
    phase outline
    call remediation.qgate-findings(retry_budget = 2, fix_budget = 2, waiver_wait_seconds = 3600, actions = [retry, fix])
        resolved -> outline.gate
        waived -> outline.gate
        exhausted -> plan.return
        fix_requested -> outline.deep
        stepped_out -> plan.return

state outline.light
    phase outline
    auto test.proceed
        done -> outline.light-regate

state outline.light-regate
    phase outline
    auto test.gate
        pass -> outline.light-review
        deep -> outline.deep

state outline.light-review
    phase outline
    job test.build
        succeeded -> outline.gate
        failed -> outline.light-regate
        cancelled -> plan.return

state outline.gate
    phase outline
    auto test.proceed
        done -> plan.derive
