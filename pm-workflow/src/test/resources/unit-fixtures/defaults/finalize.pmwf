---
name: phase-6-finalize
description: The finalize phase sub-workflow of the plan unit.
type: subworkflow
icon: phase.finalize
entry: start
entry: adopt
entry: hand_back
entry: post_run
exit: completed
exit: handed_back
exit: returned
exit: reentry
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# The finalize phase (Phase 6) as its own unit, written for the invariant and unit-loader tests, never copied from
# the product. The push barrier is the only push before the pull request; finalize.merge-gate precedes the merge,
# which completes the branch cleanup; the landing is completed; finalize.archive-plan alone enters the delivery
# terminals. A plan that must go on re-enters execute: that is the `reentry` outcome of the phase, not a phase of its
# own. The completes clauses name the mandatory steps of the test roster.
workflow phase-6-finalize version 1 format 1
scope subworkflow
entry start -> finalize.push-barrier
entry adopt -> finalize.create-pr
entry hand_back -> finalize.hand-back
entry post_run -> finalize.archive-plan

state finalize.push-barrier
    call git.commit_and_push(push_mode = push)
        done -> finalize.create-pr
        stepped_out -> finalize.stepped-out-exit

state finalize.create-pr
    auto test.proceed
        done -> finalize.merge-gate
            completes default:create-pr as done

state finalize.merge-gate
    auto test.proceed
        done -> finalize.merge

state finalize.merge
    auto test.merge
        merged -> finalize.land
            completes default:branch-cleanup as done
        not_merged -> finalize.hand-back

state finalize.land
    auto test.proceed
        done -> finalize.archive-plan
            completes default:emit-landing as done

state finalize.hand-back
    auto test.proceed
        done -> finalize.archive-plan

state finalize.archive-plan
    auto test.deliver
        completed -> completed
            completes default:archive-plan as done
        handed_back -> handed_back
            completes default:archive-plan as done
        returned -> returned
            completes default:archive-plan as done
        reentry -> finalize.reentry
            completes default:archive-plan as done

state finalize.reentry
    auto test.proceed
        done -> finalize.reentry-exit

state finalize.reentry-exit terminal reentry success

state finalize.stepped-out-exit terminal stepped_out stepped_out

state completed terminal completed success

state handed_back terminal handed_back failure

state returned terminal returned failure
