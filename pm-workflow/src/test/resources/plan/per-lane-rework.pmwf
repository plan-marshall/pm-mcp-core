---
name: plan
description: A plan unit with the per-lane phase calls and their rework, written for the composer tests.
type: workflow
icon: unit.plan
modification_date: 2026-10-21
version: 0.1.0
author: plan-marshall
---
# A plan unit written for the composer tests, never copied from a unit of the product. The two lanes split at
# init.ready: the deep lane enters refine.analyze, the light lane the light envelope outline.light, whose accepted
# outline passes the light gate outline.light-gate; the gate's deep outcome, the light -> deep ratchet, enters
# refine.analyze. Each lane calls the phases through its own call states — phases.plan and
# phases.execute for the deep lane, phases.plan-light and phases.execute-light for the light lane — and each routes
# the rework exits of its calls to its own authoring entry: fix_requested and loop_back re-enter outline.deep in the
# deep lane and outline.light in the light lane. No state of the deep route transitions into the light route. Every
# rework cycle passes an awaited job (Rule 11b): refine.analyze, outline.deep and outline.light are model jobs. The
# deep lane enters its plan call at outline.gate; the light lane enters its own through the approval of the light
# outline, whose revise answer re-enters outline.light. The land lane enters the deep execute call and the adopt lane
# the pull request of finalize straight from init.ready; neither passes a refine, outline or plan state on its way in,
# and both belong to no lane the composer prunes. The land lane shares the deep execute call, so a rework exit of that
# call re-enters outline.deep, as the shared deep call states of the product do.
workflow plan version 1 format 1
scope plan
start init.ready

state init.ready
    auto test.lane
        deep -> refine.analyze
        light -> outline.light
        land -> phases.execute
        adopt -> finalize.create-pr

state refine.analyze
    job llm change role refine
        approved -> outline.deep
        lost -> plan.return

state outline.deep
    job llm change role outline
        approved -> outline.gate
        lost -> plan.return

state outline.light
    job llm change role outline
        approved -> outline.light-gate
        lost -> plan.return

state outline.light-gate
    auto test.gate
        pass -> outline.light-approve
        deep -> refine.analyze

state outline.light-approve
    question review
        approve -> phases.plan-light
        revise -> outline.light

state outline.gate
    auto test.proceed
        done -> phases.plan

state phases.plan
    call phase-plan
        ready -> phases.execute
        fix_requested -> outline.deep
        loop_back -> outline.deep
        returned -> plan.return
        stepped_out -> finalize.hand-back

state phases.plan-light
    call phase-plan-light
        ready -> phases.execute-light
        fix_requested -> outline.light
        loop_back -> outline.light
        returned -> plan.return
        stepped_out -> finalize.hand-back

state phases.execute
    call phase-execute
        ready -> finalize.create-pr
        fix_requested -> outline.deep
        loop_back -> outline.deep
        returned -> plan.return
        stepped_out -> finalize.hand-back

state phases.execute-light
    call phase-execute-light
        ready -> finalize.create-pr
        fix_requested -> outline.light
        loop_back -> outline.light
        returned -> plan.return
        stepped_out -> finalize.hand-back

state plan.return
    auto test.proceed
        done -> finalize.archive-plan

state finalize.hand-back
    auto test.proceed
        done -> finalize.archive-plan

state finalize.create-pr
    auto test.proceed
        done -> finalize.branch-cleanup
            completes default:create-pr as done

state finalize.branch-cleanup
    auto test.proceed
        done -> finalize.land
            completes default:branch-cleanup as done

state finalize.land
    auto test.proceed
        done -> finalize.archive-plan
            completes default:emit-landing as done

state finalize.archive-plan
    auto test.deliver
        completed -> completed
            completes default:archive-plan as done
        handed_back -> handed_back
            completes default:archive-plan as done
        returned -> returned
            completes default:archive-plan as done
        reentry -> finalize.reentry
            completes default:archive-plan as done

state finalize.reentry
    auto test.proceed
        done -> finalize.reentry-exit

state finalize.reentry-exit terminal reentry success

state completed terminal completed success

state handed_back terminal handed_back failure

state returned terminal returned failure
