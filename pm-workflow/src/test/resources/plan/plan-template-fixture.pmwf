---
name: plan
description: A plan template written for the composer tests.
type: workflow
icon: unit.plan
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# A merged plan template written for the composer tests, never copied from a unit of the product. The push barrier,
# the pull request, the call site of the asking axis, a Q-Gate remediation call that binds every action, the merge
# gate, the merge barrier, the merge execution (the dispatch, the queue wait and the queue exit) a rule over the bound
# asking variant prunes, the landing, and finalize.archive-plan, which alone enters the delivery terminals. The barrier
# settles pass_hand_back into the hand-back where the merge execution is pruned, so its pass is settled by the prune
# record. The landing, a step of the post-run band, follows the merge and the hand-back alike. The completes clauses
# name the mandatory steps of the test roster.
workflow plan version 1 format 1
scope plan
start finalize.push-barrier

state finalize.push-barrier
    call git.commit_and_push(push_mode = push)
        done -> finalize.create-pr
        stepped_out -> finalize.hand-back

state finalize.create-pr
    auto test.proceed
        done -> phases.ask
            completes default:create-pr as done

state phases.ask
    call ask.questions-only
        continue -> finalize.remediate
        stepped_out -> finalize.hand-back

state finalize.remediate
    call remediation.qgate-findings(retry_budget = 1, fix_budget = 3, waiver_wait_seconds = 0, actions = [retry, fix, loop_back])
        resolved -> finalize.merge-gate
        waived -> finalize.merge-gate
        exhausted -> finalize.hand-back
        fix_requested -> finalize.hand-back
        stepped_out -> finalize.hand-back

state finalize.merge-gate
    auto test.proceed
        done -> finalize.merge-barrier

state finalize.merge-barrier
    auto test.merge-barrier
        pass -> finalize.merge-dispatch
        pass_hand_back -> finalize.hand-back
            completes default:branch-cleanup as done

state finalize.merge-dispatch
    auto test.proceed
        done -> finalize.merge-queue-wait

state finalize.merge-queue-wait
    auto test.merge
        merged -> finalize.merge-queue-exit
            completes default:branch-cleanup as done
        not_merged -> finalize.hand-back

state finalize.merge-queue-exit
    auto test.proceed
        done -> finalize.land

state finalize.land
    auto test.proceed
        done -> finalize.archive-plan
            completes default:emit-landing as done

state finalize.hand-back
    auto test.proceed
        done -> finalize.land

state finalize.archive-plan
    auto test.deliver
        completed -> completed
            completes default:archive-plan as done
        handed_back -> handed_back
            completes default:archive-plan as done
        returned -> returned
            completes default:archive-plan as done
        reentry -> finalize.reentry
            completes default:archive-plan as done

state finalize.reentry
    auto test.proceed
        done -> finalize.reentry-exit

state finalize.reentry-exit terminal reentry success

state completed terminal completed success

state handed_back terminal handed_back failure

state returned terminal returned failure
