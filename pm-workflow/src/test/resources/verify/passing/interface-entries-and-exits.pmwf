---
name: verify.interface-entries-and-exits
description: A called unit with two entries and two exits, written for the verifier tests.
type: subworkflow
icon: workflow.default
entry: main
entry: repair
exit: done
exit: failed
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
workflow verify.interface-entries-and-exits version 1 format 1
scope subworkflow
entry main -> verify.entry
entry repair -> verify.repair

state verify.entry
    auto test.prepare
        done -> verify.done
        skipped -> verify.failed

state verify.repair
    job test.build
        succeeded -> verify.done
        failed -> verify.failed
        cancelled -> verify.stepped-out

state verify.done terminal done success

state verify.failed terminal failed failure

state verify.stepped-out terminal stepped_out stepped_out
