---
name: verify.type-subworkflow
description: A called unit of the type subworkflow, written for the verifier tests.
type: subworkflow
entry: main
exit: done
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
workflow verify.type-subworkflow version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    phase inherit
    auto test.prepare
        done -> verify.done
        skipped -> verify.stepped-out

state verify.done terminal done success
    phase inherit

state verify.stepped-out terminal stepped_out stepped_out
    phase inherit
