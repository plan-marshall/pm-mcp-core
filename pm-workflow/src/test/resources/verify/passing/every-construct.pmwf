---
name: adjudicate.decisions
description: A unit written for the verifier tests.
type: subworkflow
icon: workflow.default
exit: done
exit: skipped
exit: failed
exit: aborted
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# A sub-workflow written for the verifier tests, not taken from any default unit. It uses
# every construct of the grammar: param and result
# declarations of every type, declare, start and migrate, every state form (links,
# auto, job, composite_job, job llm with each, role each, ask, consult and lost, call,
# question, terminal), links with bounded, unbounded and optional text parameters and
# explicit forms, the escalate link request_waiver, guards with every atom, combinator and
# depends_on_config, facts, skill, and result guards as the complementary pair on the
# done of a call whose callee declares a result schema. It holds every construct the rules
# reach: a STEP_LIST dispatch hub whose targets open the firings of the steps and every pass
# of which settles one step, completions on every firing path, a step completed as waived on
# the waived outcome of a remediation
# call, the review loop rejected -> verify.review, an enqueuing primitive whose job-starting
# outcome enters a job state, an artifact producer before its consumer, and the route
# abort_landed of epic.next-work into epic.aborted. It is named adjudicate.decisions
# because Rule 1 admits the form 'role each' in that unit only. It passes every check of
# the static verifier.
workflow adjudicate.decisions version 2 format 1
scope subworkflow
param mode : enum[strict|lenient]
param rounds : int[1..5]
param depth : int
param targets : list<enum[origin|mirror]>
result schema[commit-result]
declare max_rounds = 3
start verify.entry
migrate verify.begin -> verify.entry

state verify.entry
    skill pm/verify/start
    facts test.read-facts
    link next proceed ()
        do test.proceed
            done -> verify.next-step
    link submit choose:<entity> [submit] (note: text[1..80], comment: text?)
        guard in_worktree or has_open_findings and not all_tasks_completed
        depends_on_config [project.review.mode]
        do test.choose
            chosen -> verify.next-step
            declined -> verify.entry
    link retry again [noop] ()
        guard (in_worktree and not has_open_findings) or predicate:test.ready
        do test.proceed
            done -> verify.ask
    link escalate request_waiver (note: text[1..80], comment: text)
        do test.choose
            chosen -> verify.entry
            declined -> verify.entry

state verify.next-step
    auto test.next-step
        first -> verify.prepare
        second -> verify.build
        settled -> verify.remediate

state verify.prepare
    auto test.prepare
        done -> verify.compose
            completes verify:prepare as done
        skipped -> verify.compose
            completes verify:prepare as skipped

state verify.build
    job test.build
        succeeded -> verify.compose
            completes verify:build as done
        failed -> verify.failed
            completes verify:build as failed
        cancelled -> verify.failed
            completes verify:build as failed

state verify.remediate
    call remediation.test-waiver()
        done -> verify.compose
            completes verify:probe as done
        waived -> verify.compose
            completes verify:probe as waived
        stepped_out -> verify.stepped-out

state verify.compose
    composite_job test.build
        succeeded -> verify.adjudicate
        failed -> verify.failed
        cancelled -> verify.failed

state verify.adjudicate
    job llm change role each test.list-roles
        approved -> verify.review
        lost -> verify.failed

state verify.review
    job llm change role implementer each test.list-changes ask
    consult role reviewer
        approved -> verify.judge
        lost -> verify.failed

state verify.judge
    job llm judgement role reviewer
        approved -> verify.commit
        rejected -> verify.review
        lost -> verify.failed

state verify.commit
    call git.commit_and_push(push = enabled, attempts = 2, targets = [origin, mirror])
        done -> verify.produce
            guard result.pushed
        done -> verify.ask
            guard not result.pushed
        stepped_out -> verify.stepped-out

state verify.produce
    auto test.produce
        done -> verify.enqueue

state verify.enqueue
    auto test.enqueue
        enqueued -> verify.publish
        skipped -> verify.consume

state verify.publish
    job test.build
        succeeded -> verify.consume
        failed -> verify.failed
        cancelled -> verify.failed

state verify.consume
    auto test.consume
        done -> verify.done

state verify.ask
    question clarification
        answered -> verify.askflow

state verify.askflow
    question review
        approve -> epic.next-work
        revise -> verify.skipped

state epic.next-work
    auto test.land-work
        landed -> verify.done
        abort_landed -> epic.aborted

state verify.done terminal done success

state verify.skipped terminal skipped skip

state verify.failed terminal failed failure

state verify.stepped-out terminal stepped_out stepped_out

state epic.aborted terminal aborted failure
