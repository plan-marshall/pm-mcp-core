---
name: verify.result-guard-single-done
description: A unit written for the verifier tests.
type: subworkflow
icon: workflow.default
entry: main
exit: done
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 17
workflow verify.result-guard-single-done version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    phase inherit
    call git.commit_and_push(push = enabled, attempts = 2, targets = [origin])
        done -> verify.done
            guard result.pushed
        stepped_out -> verify.stepped-out

state verify.done terminal done success
    phase inherit

state verify.stepped-out terminal stepped_out stepped_out
    phase inherit
