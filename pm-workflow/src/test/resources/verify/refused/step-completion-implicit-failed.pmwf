---
name: verify.step-completion-implicit-failed
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: STEP_COMPLETION state verify.entry line 21
workflow verify.step-completion-implicit-failed version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    auto test.prepare
        done -> verify.done
            completes test:step as done
        skipped -> plan.return
            completes test:step as failed

state plan.return terminal returned failure
    phase verify

state verify.done terminal done success
    phase verify
