---
name: verify.cycle-measure-archive-path
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: EXIT_PATH state verify.next line 24
# expect: STEP_COMPLETION state verify.next line 24
# The archive-steps state of an epic unit loops on itself and reaches no terminal state; a
# state off every archive path also has no exit, so EXIT_PATH refuses it as well.
workflow verify.cycle-measure-archive-path version 1 format 1
scope epic
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.next
        skipped -> verify.done

state verify.next
    auto test.next-work
        archive_uncommitted -> verify.next
        archived -> verify.next

state verify.done terminal done success
