# expect: REACHABILITY state verify.orphan line 22
# A plan unit with a state no transition enters.
workflow verify.unreachable version 1 format 1
scope plan
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.done
        skipped -> verify.done

state verify.orphan
    auto test.prepare
        done -> verify.done
        skipped -> verify.done

state verify.done terminal done success
