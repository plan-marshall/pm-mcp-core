# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 19
workflow verify.result-guard-callee-without-schema version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    call test.depth5()
        done -> verify.done
            guard result.pushed
        done -> verify.done
            guard not result.pushed
        stepped_out -> verify.stepped-out

state verify.done terminal done success

state verify.stepped-out terminal stepped_out stepped_out
