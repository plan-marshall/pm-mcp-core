---
name: verify.consultation
description: A unit written for the verifier tests.
type: system
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: LINK_ID_UNIQUE state verify.entry line 19
# expect: LEAF_TASK_CONSTRAINT state verify.entry line 19
# A consultation unit that offers a consult link; a declared consult: identifier also
# repeats the implicit consult link, so LINK_ID_UNIQUE refuses it as well.
workflow verify.consultation version 1 format 1
scope workspace
start verify.entry

state verify.entry
    phase verify
    link next consult:review ()
        do test.proceed
            done -> verify.done

state verify.done terminal done success
    phase verify
