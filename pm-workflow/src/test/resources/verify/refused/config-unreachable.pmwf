# expect: CONFIG_REACHABILITY state verify.conditional line 18
workflow verify.config-reachability version 1 format 1
scope workspace
start verify.entry

state verify.entry
    phase verify
    link next choose [submit] (note: text[1..80], comment: text)
        guard in_worktree
        depends_on_config [feature.flag]
        do test.choose
            chosen -> verify.conditional
            declined -> verify.done
    link next fallback ()
