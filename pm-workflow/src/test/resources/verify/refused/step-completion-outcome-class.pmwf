# expect: STEP_COMPLETION state verify.entry line 21
workflow verify.step-completion-outcome-class version 1 format 1
scope plan
start verify.entry

state verify.entry
    job test.build
        succeeded -> verify.done
            completes test:class as done
        failed -> verify.done
            completes test:class as done
        cancelled -> verify.done
            completes test:class as failed

state verify.done terminal done success
