# expect: STEP_COMPLETION state verify.entry line 18
workflow verify.step-completion-question-class version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    question clarification
        answered -> verify.done
            completes test:step as done
        assumed -> verify.decide

state verify.decide
    phase verify
    auto test.prepare
        done -> verify.done
            completes test:step as done
        skipped -> verify.done
            completes test:step as skipped

state verify.done terminal done success
    phase verify
