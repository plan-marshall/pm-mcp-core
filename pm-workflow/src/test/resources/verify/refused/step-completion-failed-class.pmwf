# expect: STEP_COMPLETION state verify.entry line 20
workflow verify.step-completion-failed-class version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    auto test.fix
        fixed -> verify.done
            completes test:step as done
        fix_requested -> verify.done
            completes test:step as failed

state verify.done terminal done success
    phase verify
