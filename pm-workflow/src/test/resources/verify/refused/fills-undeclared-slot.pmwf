---
name: verify.fills-undeclared
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.fill line 20
workflow verify.fills-undeclared version 1 format 1
scope plan
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.fill
        skipped -> verify.done

state verify.fill
    fills slot.message from message
    job llm change role reviewer
        approved -> verify.done
        lost -> verify.done

state verify.done terminal done success
