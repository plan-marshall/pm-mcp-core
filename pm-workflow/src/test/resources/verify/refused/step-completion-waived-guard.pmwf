---
name: verify.waived-guard
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: STEP_COMPLETION state verify.entry line 18
workflow verify.waived-guard version 1 format 1
scope plan
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.done
            completes test:waived as waived
        skipped -> verify.done
            completes test:waived as skipped

state verify.done terminal done success
