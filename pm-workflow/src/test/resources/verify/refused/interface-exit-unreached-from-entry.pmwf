---
name: verify.interface-exit-unreached-from-entry
description: A unit written for the verifier tests.
type: subworkflow
icon: workflow.default
entry: main
exit: done
exit: failed
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: INTERFACE_EXIT_REACHED state verify.entry line 1 column 1
# expect: REACHABILITY state verify.failed line 28 column 1
workflow verify.interface-exit-unreached-from-entry version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    auto test.prepare
        done -> verify.done
        skipped -> verify.done

state verify.done terminal done success

state verify.failed terminal failed failure
