# expect: STEP_COMPLETION state verify.entry line 20
workflow verify.step-completion-skipped-route version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    job test.build
        succeeded -> verify.done
            completes test:step as done
        failed -> verify.done
            completes test:step as skipped
        cancelled -> verify.done
            completes test:step as failed

state verify.done terminal done success
    phase verify
