---
name: verify.cycle-noop-without-event
description: A unit written for the verifier tests.
type: subworkflow
icon: workflow.default
entry: main
exit: done
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: CYCLE_AWAITED_EVENT state verify.entry line 17
workflow verify.cycle-noop-without-event version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    phase inherit
    skill pm/verify/start
    link next proceed ()
        do test.proceed
            done -> verify.entry
    link submit finish [submit] (note: text[1..80], comment: text)
        do test.choose
            chosen -> verify.done
            declined -> verify.done

state verify.done terminal done success
    phase inherit
