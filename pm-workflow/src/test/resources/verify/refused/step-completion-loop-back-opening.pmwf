---
name: verify.step-completion-loop-back-opening
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: STEP_COMPLETION state verify.entry line 21
# Step s is completed on a loop-back into its own opening, which its firing passes: the opening
# still begins s, so the path that leaves it with the outcome skipped and no completion is refused.
workflow verify.step-completion-loop-back-opening version 1 format 1
scope plan
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.work
        skipped -> verify.done

state verify.work
    job test.build
        succeeded -> verify.done
            completes step:s as done
        failed -> verify.entry
            completes step:s as failed
        cancelled -> verify.done
            completes step:s as failed

state verify.done terminal done success
