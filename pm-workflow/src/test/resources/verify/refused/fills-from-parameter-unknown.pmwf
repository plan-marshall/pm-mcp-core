---
name: verify.fills-from
description: A unit written for the verifier tests.
type: workflow
icon: workflow.default
slot: message
slot_type: commit_message[1..2000]
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.answer line 22
workflow verify.fills-from version 1 format 1
scope plan
start verify.entry

state verify.entry
    auto test.prepare
        done -> verify.answer
        skipped -> verify.answer

state verify.answer
    fills slot.message from message
    link submit answer (note: text[1..80], comment: text)
        do test.choose
            chosen -> verify.done
            declined -> verify.done

state verify.done terminal done success
