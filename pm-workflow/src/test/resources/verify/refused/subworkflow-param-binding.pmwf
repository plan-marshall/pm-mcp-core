# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 6
workflow verify.subworkflow-param-binding version 1 format 1
scope subworkflow
start verify.entry

state verify.entry
    phase inherit
    call git.commit_and_push(push = enabled, attempts = 2)
        done -> verify.done
        stepped_out -> verify.stepped-out

state verify.done terminal done success
    phase inherit

state verify.stepped-out terminal stepped_out stepped_out
    phase inherit
