---
name: verify.subworkflow-param-binding
description: A unit written for the verifier tests.
type: subworkflow
entry: main
exit: done
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 16
workflow verify.subworkflow-param-binding version 1 format 1
scope subworkflow
entry main -> verify.entry

state verify.entry
    phase inherit
    call git.commit_and_push(push = enabled, attempts = 2)
        done -> verify.done
        stepped_out -> verify.stepped-out

state verify.done terminal done success
    phase inherit

state verify.stepped-out terminal stepped_out stepped_out
    phase inherit
