---
name: verify.subworkflow-stepped-out-unrouted
description: A unit written for the verifier tests.
type: workflow
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 16
# The callee test.depth5 has no terminal of class stepped_out; the call still owes the route
# of stepped_out, which is part of every sub-workflow's exit contract implicitly (Rule 6).
workflow verify.subworkflow-stepped-out-unrouted version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    call test.depth5()
        done -> verify.done

state verify.done terminal done success
    phase verify
