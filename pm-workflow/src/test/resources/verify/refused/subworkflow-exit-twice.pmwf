---
name: verify.subworkflow-exit-twice
description: A unit written for the verifier tests.
type: workflow
modification_date: 2026-01-15
version: 0.1.0
author: plan-marshall
---
# expect: SUBWORKFLOW_CALL_CONTRACT state verify.entry line 14
workflow verify.subworkflow-exit-twice version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    call test.depth5()
        done -> verify.done
        stepped_out -> plan.return
        stepped_out -> finalize.hand-back

state plan.return terminal returned failure
    phase verify

state finalize.hand-back terminal handed_back failure
    phase verify

state verify.done terminal done success
    phase verify
