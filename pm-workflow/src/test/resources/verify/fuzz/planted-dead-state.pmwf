# A unit written for the transition fuzzer tests, not taken from any default unit. The link
# state verify.gate has one link, guarded by in_worktree: under an assignment with
# in_worktree=false no exit of it holds, so it is a dead state the fuzzer must find. The unit
# passes every check of the static verifier, which reads no guard. control.pmwf is this unit
# without the planted guard.
workflow verify.fuzz version 1 format 1
scope plan
start verify.entry

state verify.entry
    phase verify
    link next proceed ()
        do test.proceed
            done -> verify.gate
    link alt detour ()
        guard (has_open_findings and predicate:test.ready) or not all_tasks_completed
        do test.proceed
            done -> verify.prepare

state verify.prepare
    phase verify
    auto test.prepare
        done -> verify.gate
        skipped -> verify.done

state verify.gate
    phase verify
    link next enter ()
        guard in_worktree
        do test.proceed
            done -> verify.done

state verify.done terminal done success
    phase verify
