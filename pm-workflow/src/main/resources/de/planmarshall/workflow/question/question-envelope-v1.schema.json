{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuioss.de/plan-marshall-mcp/schemas/question-envelope-v1.json",
  "title": "QuestionEnvelope",
  "type": "object",
  "required": ["question_text", "decision_kind", "answer_type", "options", "recommendation", "own_words", "note", "delegation"],
  "additionalProperties": false,
  "properties": {
    "part_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$", "description": "A key the dependency of another part of the same envelope names; replaced by the question_id when the server persists the part." },
    "question_text": { "type": "string", "minLength": 10, "maxLength": 500 },
    "decision_kind": {
      "type": "string",
      "enum": ["interpretation", "approach", "granularity", "placement", "test_strategy", "scope", "product_behaviour", "assurance", "external_fact"],
      "description": "What the question decides (model-work/10, Decision Kinds)."
    },
    "answer_type": { "type": "string", "enum": ["one", "several", "value"] },
    "value_schema": {
      "type": ["object", "null"],
      "description": "For answer_type value only: {type: text, max_length} | {type: integer, minimum, maximum} | {type: key, keys[]}; null otherwise."
    },
    "options": {
      "type": "array",
      "maxItems": 5,
      "description": "Two to five for one and several, none for value.",
      "items": {
        "type": "object",
        "required": ["branch_key", "label", "description", "consequences"],
        "additionalProperties": false,
        "properties": {
          "branch_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$", "description": "Deterministic enum key bound to a state transition or parameter assignment." },
          "label": { "type": "string", "minLength": 2, "maxLength": 80 },
          "description": { "type": "string", "minLength": 5, "maxLength": 240, "description": "The option's trade-off." },
          "consequences": { "type": "string", "minLength": 5, "maxLength": 500 },
          "preview": { "type": ["string", "null"], "maxLength": 4000, "description": "A diff, a text, or a pm:// URI." }
        }
      }
    },
    "depends_on": {
      "type": ["object", "null"],
      "required": ["part_key", "options"],
      "additionalProperties": false,
      "properties": {
        "part_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" } }
      }
    },
    "recommendation": {
      "type": ["object", "null"],
      "required": ["branch_key", "confidence", "rationale"],
      "additionalProperties": false,
      "properties": {
        "branch_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100, "description": "The asker's confidence that the recommended option is right." },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 500, "description": "Why the recommended option, naming the evidence." }
      },
      "description": "Required for one and several; null for value."
    },
    "own_words": { "type": "boolean" },
    "note": { "type": "boolean" },
    "delegation": { "type": "boolean" }
  }
}
