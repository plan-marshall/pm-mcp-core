        <groupId>de.planmarshall</groupId>
        <artifactId>pm-mcp-core</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>guard-control-provider-product-module</artifactId>
    <packaging>pom</packaging>
    <name>guard-control-provider-product-module</name>
    <properties>
        <pm.guard.provider.skip>false</pm.guard.provider.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-mcp-parent</artifactId>
            <version>0.1.0</version>
            <type>pom</type>
        </dependency>
    </dependencies>
</project>
