**/.settings
**/target
**/bin
**/.idea
**/src/main/gen
*.iml
*.classpath
*.project
**/.vscode
.DS_Store
.asciidoctorconfig.adoc
.factorypath
src/guard-controls/**/target

# Planning system (managed by plan-marshall)
# Runtime state (plans, run-configuration, lessons-learned, memory, logs — managed by plan-marshall)
.plan/*
!.plan/marshal.json
!.plan/project-architecture/

# The orchestrator ledger is git-tracked, repo-local state: both homes of an epic
# (active and archived) are un-ignored.
!.plan/orchestrator/
!.plan/archived-orchestrators/

# Re-ignored after the negations above, because a later rule wins: the per-verb
# append log is machine-local.
.plan/orchestrator/*/logs/
.plan/archived-orchestrators/*/logs/
